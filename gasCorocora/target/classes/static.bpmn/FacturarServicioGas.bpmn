    <bpmn:businessRuleTask id="Activity_0qfaemj" name="Validar lectura de consumo" camunda:resultVariable="resultado" camunda:decisionRef="validarLectura" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="Output_2cdcuv6" />
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0wqzfx8</bpmn:incoming>
      <bpmn:incoming>Flow_19ccm41</bpmn:incoming>
      <bpmn:outgoing>Flow_0bldkwu</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_1g07c6m" name="¿Lectura válida?">
      <bpmn:incoming>Flow_0bldkwu</bpmn:incoming>
      <bpmn:outgoing>Flow_1q03may</bpmn:outgoing>
      <bpmn:outgoing>Flow_0yrl209</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="Event_0eehjdj" name="Inició facturación mensual">
      <bpmn:outgoing>Flow_1eifeqq</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1ojaoab">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 1 1/1 * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Activity_0boenit" name="Validar tipo cliente" camunda:resultVariable="categoriaCliente" camunda:decisionRef="tipoCliente" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_1q03may</bpmn:incoming>
      <bpmn:outgoing>Flow_1xs766b</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="Activity_0r7wfma" name="Consultar consumos de medidores">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="consumo" label="Consumo" type="long" />
          <camunda:formField id="clienteId" label="ID del cliente" type="string" />
          <camunda:formField id="tarifa" label="Tarifa %" type="long" defaultValue="100" />
          <camunda:formField id="fecha" label="Fecha de revision" type="date" datePattern="dd/MM/yyyy" />
        </camunda:formData>
        <camunda:inputOutput>
          <camunda:outputParameter name="tipoLectura">AUTOMATICA</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1eifeqq</bpmn:incoming>
      <bpmn:outgoing>Flow_19ccm41</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Activity_0ygb5c4" name="Detectar anomalías" camunda:resultVariable="alerta" camunda:decisionRef="DetectarAnomalias" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_1ha1dq5</bpmn:incoming>
      <bpmn:outgoing>Flow_1g3axxo</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_0g6kmjb" name="¿Hay fraude?" default="Flow_01t6she">
      <bpmn:incoming>Flow_1g3axxo</bpmn:incoming>
      <bpmn:outgoing>Flow_01t6she</bpmn:outgoing>
      <bpmn:outgoing>Flow_1g384le</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_0yys6x3" name="Revisar caso para facturacion manual">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="aprobarFactura" label="Aprueba facturacion manual" type="boolean" defaultValue="true" />
          <camunda:formField id="comentario" label="Comentarios del supervisor" type="string" defaultValue="Realizar evaluacion" />
        </camunda:formData>
        <camunda:inputOutput>
          <camunda:outputParameter name="facturacionManual">${true}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1g384le</bpmn:incoming>
      <bpmn:outgoing>Flow_0ecg684</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_037f06c" name="¿Facturacion manual aprobada?" default="Flow_11zeify">
      <bpmn:incoming>Flow_0ecg684</bpmn:incoming>
      <bpmn:outgoing>Flow_11zeify</bpmn:outgoing>
      <bpmn:outgoing>Flow_06f2qot</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_1ktp4tg" name="Congelar servicio">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="respuestaFin" label="Servicio congelado por:" type="string" defaultValue="Fraude" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06f2qot</bpmn:incoming>
      <bpmn:outgoing>Flow_0qi4aqk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_1myg0e6" name="Servicio cancelado">
      <bpmn:incoming>Flow_0qi4aqk</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_00vgrcv" />
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_0kjt35z" name="Realizar lectura manualmente" camunda:assignee="operador">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="operador" label="Operador" type="string" defaultValue="Vanessa" />
          <camunda:formField id="medidor" label="Numero medidor" type="long" defaultValue="4789" />
          <camunda:formField id="consumo" label="Consumo" type="long" />
          <camunda:formField id="fecha" label="Fecha de revision" type="date" />
          <camunda:formField id="observaciones" label="Observaciones" type="string" defaultValue="Medidor con fallas. Se recomienda cambio" />
        </camunda:formData>
        <camunda:inputOutput>
          <camunda:outputParameter name="tipoLectura">MANUAL</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0yrl209</bpmn:incoming>
      <bpmn:incoming>Flow_11zeify</bpmn:incoming>
      <bpmn:outgoing>Flow_0wqzfx8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0wqzfx8" sourceRef="Activity_0kjt35z" targetRef="Activity_0qfaemj" />
    <bpmn:sequenceFlow id="Flow_19ccm41" sourceRef="Activity_0r7wfma" targetRef="Activity_0qfaemj" />
    <bpmn:sequenceFlow id="Flow_0bldkwu" sourceRef="Activity_0qfaemj" targetRef="Gateway_1g07c6m" />
    <bpmn:sequenceFlow id="Flow_1q03may" name="Si" sourceRef="Gateway_1g07c6m" targetRef="Activity_0boenit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultado == "VÁLIDO"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0yrl209" name="No" sourceRef="Gateway_1g07c6m" targetRef="Activity_0kjt35z">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultado != "VÁLIDO"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1eifeqq" sourceRef="Event_0eehjdj" targetRef="Activity_0r7wfma" />
    <bpmn:sequenceFlow id="Flow_1xs766b" sourceRef="Activity_0boenit" targetRef="Activity_1u1mrjh" />
    <bpmn:sequenceFlow id="Flow_1ha1dq5" sourceRef="Activity_1u1mrjh" targetRef="Activity_0ygb5c4" />
    <bpmn:sequenceFlow id="Flow_01t6she" name="No" sourceRef="Gateway_0g6kmjb" targetRef="Activity_03u9eyg" />
    <bpmn:sequenceFlow id="Flow_0gbe4ge" sourceRef="Activity_03u9eyg" targetRef="Activity_1x2jmpq" />
    <bpmn:sequenceFlow id="Flow_1l33z5y" sourceRef="Activity_0ugerbt" targetRef="Activity_11xskn3" />
    <bpmn:sequenceFlow id="Flow_1g3axxo" sourceRef="Activity_0ygb5c4" targetRef="Gateway_0g6kmjb" />
    <bpmn:sequenceFlow id="Flow_1g384le" name="Si" sourceRef="Gateway_0g6kmjb" targetRef="Activity_0yys6x3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${alerta == "POSIBLE FRAUDE"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0ecg684" sourceRef="Activity_0yys6x3" targetRef="Gateway_037f06c" />
    <bpmn:sequenceFlow id="Flow_11zeify" name="Si" sourceRef="Gateway_037f06c" targetRef="Activity_0kjt35z" />
    <bpmn:sequenceFlow id="Flow_06f2qot" name="No" sourceRef="Gateway_037f06c" targetRef="Activity_1ktp4tg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${aprobarFactura== "Checked"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0qi4aqk" sourceRef="Activity_1ktp4tg" targetRef="Event_1myg0e6" />
    <bpmn:businessRuleTask id="Activity_1u1mrjh" name="Validar subsidio" camunda:resultVariable="subsidio" camunda:decisionRef="CalcularSubsidio" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_1xs766b</bpmn:incoming>
      <bpmn:outgoing>Flow_1ha1dq5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Activity_03u9eyg" name="Calcular valor de factura" camunda:expression="${(consumo * tarifa).longValue()}" camunda:resultVariable="totalFactura">
      <bpmn:incoming>Flow_01t6she</bpmn:incoming>
      <bpmn:outgoing>Flow_0gbe4ge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_183jz1z" sourceRef="Activity_1x2jmpq" targetRef="Activity_0mwsc4b" />
    <bpmn:serviceTask id="Activity_1x2jmpq" name="Aplicar descuentos de subsidio" camunda:expression="${(totalFactura - (subsidio * totalFactura / 100)).longValue()}" camunda:resultVariable="totalDescuento">
      <bpmn:incoming>Flow_0gbe4ge</bpmn:incoming>
      <bpmn:outgoing>Flow_183jz1z</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1v4ks53" sourceRef="Activity_0sur232" targetRef="Event_0fwntzp" />
    <bpmn:sequenceFlow id="Flow_1t1nqyo" sourceRef="Activity_0mwsc4b" targetRef="Activity_0ugerbt" />
    <bpmn:serviceTask id="Activity_0mwsc4b" name="generar factura">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${registrarLogFactura}" event="end" />
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="url">http://host.docker.internal:5000/factura</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="JavaScript">JSON.stringify({
  clienteId: clienteId,
  categoriaCliente: categoriaCliente,
  consumo: consumo,
  resultado: resultado,
  tarifa: tarifa,
  subsidio: subsidio,
  totalFactura: totalFactura,
  totalDescuento: totalDescuento,
  tipoLectura: tipoLectura,
  fecha: fecha,
  medidor: typeof medidor !== "undefined" ? medidor : null,
  operador: typeof operador !== "undefined" ? operador : null,
  observaciones: typeof observaciones !== "undefined" ? observaciones : null,
  comentario: typeof comentario !== "undefined" ? comentario : null,
  productos: "Servicio de gas domiciliario; Consumo: " + consumo + "; Tarifa: " + tarifa
})</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="respuestaFactura">${response}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_183jz1z</bpmn:incoming>
      <bpmn:outgoing>Flow_1t1nqyo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_0ugerbt" name="Enviar factura por correo">
      <bpmn:extensionElements>
        <camunda:taskListener event="create">
          <camunda:script scriptFormat="javascript">var tipo = task.getExecution().getVariable("tipoLectura");
var manual = task.getExecution().getVariable("facturacionManual");
task.setVariableLocal("esFacturaManual", tipo === "MANUAL" || manual === true || manual === "true");</camunda:script>
        </camunda:taskListener>
        <camunda:formData>
          <camunda:formField id="clienteId" label="ID del cliente" type="string" />
          <camunda:formField id="categoriaCliente" label="Tipo de cliente" type="string" />
          <camunda:formField id="consumo" label="Consumo leido" type="long" />
          <camunda:formField id="resultado" label="Resultado de lectura" type="string" />
          <camunda:formField id="tarifa" label="Tarifa cobrada" type="long" />
          <camunda:formField id="subsidio" label="Descuento subsidio %" type="long" />
          <camunda:formField id="totalFactura" label="Factura total" type="long" />
          <camunda:formField id="totalDescuento" label="Factura total aplicando descuentos" type="long" />
          <camunda:formField id="fecha" label="Fecha de revision" type="string" />
          <camunda:formField id="medidor" label="Numero medidor" type="string" />
          <camunda:formField id="operador" label="Operador" type="string" />
          <camunda:formField id="observaciones" label="Observaciones del operador" type="string" />
          <camunda:formField id="comentario" label="Comentarios del supervisor" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1t1nqyo</bpmn:incoming>
      <bpmn:outgoing>Flow_1l33z5y</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_0fwntzp" name="finalizó facturación">
      <bpmn:incoming>Flow_1v4ks53</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_0sur232" name="Guardar Factura" camunda:class="com.proyecto.gasCorocora.service.SaveFactura">
      <bpmn:incoming>Flow_14aywde</bpmn:incoming>
      <bpmn:outgoing>Flow_1v4ks53</bpmn:outgoing>
