    <bpmn:sequenceFlow id="Flow_14aywde" sourceRef="Activity_11xskn3" targetRef="Activity_0sur232" />
    <bpmn:serviceTask id="Activity_11xskn3" name="Sincronizar factura externa" camunda:type="external" camunda:topic="sincronizar-factura">
      <bpmn:incoming>Flow_1l33z5y</bpmn:incoming>
      <bpmn:outgoing>Flow_14aywde</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
