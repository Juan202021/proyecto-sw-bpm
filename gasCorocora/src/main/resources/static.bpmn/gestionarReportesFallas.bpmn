        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${tipoEvento == "Error de medicion" &amp;&amp; validado == "true"}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_1f6ca1v" sourceRef="Activity_103sk7u" targetRef="Activity_1aj0xzc" />
