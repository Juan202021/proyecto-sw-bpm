  <bpmn:collaboration id="Collaboration_0vg14j7">
    <bpmn:participant id="Participant_02s40sn" name="Operador" processRef="gestionar_reportes_fallas" />
  </bpmn:collaboration>
  <bpmn:process id="gestionar_reportes_fallas" isExecutable="true" camunda:historyTimeToLive="100">
    <bpmn:laneSet id="LaneSet_0fn1228" />
    <bpmn:startEvent id="Event_0xb5q9h" name="Error reportado">
      <bpmn:extensionElements />
      <bpmn:outgoing>Flow_16iu5at</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDefinition_0nlav9w" signalRef="Signal_3uju0iq" />
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_09nl3pj" name="Error manejado">
      <bpmn:incoming>Flow_1sv571c</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Activity_1ktlv3y" name="Gestionar Reportes Fallasc">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="caudal">${reporte.caudal}</camunda:inputParameter>
          <camunda:inputParameter name="temperatura">${reporte.temperatura}</camunda:inputParameter>
          <camunda:inputParameter name="presion">${reporte.presion}</camunda:inputParameter>
          <camunda:inputParameter name="comunicacionEquiposMedicionActiva">${reporte.comunicacionEquiposMedicionActiva}</camunda:inputParameter>
          <camunda:inputParameter name="fechaReporteFalla">${reporte.fechaReporteFalla}</camunda:inputParameter>
          <camunda:inputParameter name="codigoReporteFalla">${reporte.codigoReporteFalla}</camunda:inputParameter>
          <camunda:inputParameter name="domicilio">${reporte.domicilio}</camunda:inputParameter>
          <camunda:inputParameter name="codigoOrdenTrabajo">${reporte.codigoOrdenTrabajo}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16iu5at</bpmn:incoming>
      <bpmn:outgoing>Flow_1sv571c</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${reportes}" camunda:elementVariable="reporte" />
      <bpmn:startEvent id="Event_1oxxq04">
        <bpmn:outgoing>Flow_0926apj</bpmn:outgoing>
      </bpmn:startEvent>
