        <bpmn:outgoing>Flow_19r4atg</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="Event_0nf50jq" name="Error registrado">
        <bpmn:incoming>Flow_19r4atg</bpmn:incoming>
      </bpmn:endEvent>
