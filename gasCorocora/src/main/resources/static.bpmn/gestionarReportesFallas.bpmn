      <bpmn:sequenceFlow id="Flow_10qxx9i" name="Si" sourceRef="Gateway_08sp729" targetRef="Gateway_0q8ulrc">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${anomalia == "emergencia"}</bpmn:conditionExpression>
